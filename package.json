{
  "name": "agent-incidents-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "dev:demo": "INCIDENTS_DEMO=1 vite dev --host 127.0.0.1",
    "build": "INCIDENTS_DEMO=0 vite build",
    "build:demo": "INCIDENTS_DEMO=1 vite build",
    "preview": "npm run preview:static",
    "preview:demo": "wrangler dev --local --assets build-demo --ip 127.0.0.1 --port 4174",
    "preview:static": "wrangler dev --local --ip 127.0.0.1 --port 4173",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "tsc --project tsconfig.worker.json",
    "types:worker": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.145.0"
  }
}
